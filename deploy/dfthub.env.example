# Store outside the installation. chmod 600 /path/to/dfthub.env
# Export DFTHUB_ENV_FILE=/path/to/dfthub.env before starting.
DFTHUB_DATA_DIR=/var/lib/dfthub/data
DFTHUB_MAIL_SUPPRESS=1
# Optional; defaults to current Python and packaged optimizer.
# DFTHUB_PYTHON=/opt/dfthub/.venv/bin/python
# DFTHUB_TMB11_DIR=/path/to/custom-optimizer
# DFTHUB_DEMO_ROOT=/var/lib/dfthub/optimizer
# DFTHUB_AME418_ROOT=/path/to/external-AME418-checkpoints
# Resource reservations; defaults detect CPU/RAM and Linux container limits.
# DFTHUB_CPU_THREADS=16
# DFTHUB_TASK_THREADS=8
# DFTHUB_MEMORY_MB=16000
# DFTHUB_DFT_TASKS=2
# DFTHUB_OPTIMIZER_THREADS=4
# DFTHUB_PUBLIC_URL=https://your-dfthub.example
# DFTHUB_MAIL_SERVER=smtp.example.org
# DFTHUB_MAIL_PORT=587
# DFTHUB_MAIL_USE_TLS=1
# DFTHUB_MAIL_USERNAME=your-account
# DFTHUB_MAIL_PASSWORD=replace-me
# DFTHUB_MAIL_SENDER=DFThub <noreply@example.org>
# DFTHUB_ENABLE_HSTS=1
